  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Gallery image viewer" aria-hidden="true" inert><div class="lightbox-backdrop" data-close-lightbox></div><button class="lightbox-close" id="lightboxClose" aria-label="Close image viewer">✕ <span>CLOSE</span></button><button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous image">←</button><figure><img id="lightboxImage" src="" alt=""/><figcaption><strong id="lightboxTitle"></strong><span id="lightboxSubtitle"></span></figcaption></figure><button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next image">→</button></div>
  <a class="whatsapp-float" href="https://wa.me/918136846979?text=Hello%20Chellan%27s%20Studio%2C%20I%20would%20like%20to%20know%20more%20about%20your%20services." target="_blank" rel="noopener noreferrer" aria-label="Message Chellan's Studio on WhatsApp"><svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 3.5a12.4 12.4 0 0 0-10.7 18.7L3.9 28l6-1.6A12.5 12.5 0 1 0 16 3.5Z" stroke="currentColor" stroke-width="2.1"/><path d="M11.3 9.9c-.4-.8-.8-.9-1.2-.9h-1c-.3 0-.9.3-1.3.8-.4.6-1.6 1.6-1.6 4s1.6 4.6 1.8 4.9c.2.3 3 4.8 7.4 6.3 3.6 1.2 4.3 1 5.1.9.8-.1 2.5-1 2.9-2 .3-1 .3-1.8.2-2-.1-.2-.8-.4-1.6-.8-.8-.4-1.7-.8-2-.9-.3-.1-.5-.2-.8.2-.4.5-1.3 1.6-1.5 1.9-.3.3-.5.3-1 .1-.6-.2-2.1-.8-4-2.5-1.5-1.3-2.5-2.9-2.7-3.4-.3-.4 0-.7.2-.9.2-.3.5-.6.7-.9.2-.3.3-.5.5-.8.1-.4 0-.7-.1-1-.1-.3-1-2.5-1.4-3.4Z" fill="currentColor" transform="translate(3 1) scale(.77)"/></svg><span>LET'S TALK</span></a>
  <!-- The script is deliberately after the page markup so every element exists before setup. -->
  <script>
(() => {
  'use strict';
  const $ = (selector, scope = document) => scope.querySelector(selector);
  const $$ = (selector, scope = document) => [...scope.querySelectorAll(selector)];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const header = $('#siteHeader');
  const mobileNav = $('#mobileNav');
  const menuToggle = $('#menuToggle');
  const scrollProgress = $('#scrollProgress');

  // Welcome entrance: non-blocking and automatically skipped for reduced-motion users.
  const intro = $('#intro');
  if (intro) {
    if (reduceMotion) intro.remove();
    else {
      setTimeout(() => { intro.classList.add('done'); }, 1220);
      setTimeout(() => { intro.remove(); }, 2700);
    }
  }

  const updateScroll = () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
    const total = document.documentElement.scrollHeight - window.innerHeight;
    scrollProgress.style.transform = `scaleX(${total > 0 ? Math.min(1, window.scrollY / total) : 0})`;
  };
  window.addEventListener('scroll', updateScroll, { passive: true });
  window.addEventListener('resize', updateScroll, { passive: true });
  updateScroll();

  const setMenu = (open) => {
    document.body.classList.toggle('menu-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    mobileNav.inert = !open;
    if (open) $('.mobile-nav a')?.focus();
    else menuToggle.focus({preventScroll:true});
  };
  menuToggle.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
  $$('.mobile-nav a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('menu-open')) setMenu(false);
  });

  // Reveal on entering the viewport; content is visible by default if IntersectionObserver is unsupported.
  const reveals = $$('.reveal');
  document.documentElement.classList.add('js-ready');
  if (reduceMotion || !('IntersectionObserver' in window)) {
    reveals.forEach(el => el.classList.add('in-view'));
  } else {
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    }), {threshold: 0.06, rootMargin: '0px 0px -35px 0px'});
    reveals.forEach(el => observer.observe(el));
  }

  // Slideshow: all photographs are licensed example imagery, not represented as the studio's work.
  const heroImages = [
    'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=88',
    'https://images.unsplash.com/photo-1537633552985-df8429e8048b?auto=format&fit=crop&w=2000&q=88',
    'https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&w=2000&q=88'
  ];
  const heroLayers = [$('#heroA'), $('#heroB')];
  let heroCurrent = 0, heroVisibleLayer = 0;
  heroLayers[0].style.backgroundImage = `url('${heroImages[0]}')`;
  heroLayers[1].style.backgroundImage = `url('${heroImages[1]}')`;
  const goHero = (step) => {
    const nextIndex = (heroCurrent + step + heroImages.length) % heroImages.length;
    const nextLayer = 1 - heroVisibleLayer;
    heroLayers[nextLayer].style.backgroundImage = `url('${heroImages[nextIndex]}')`;
    heroLayers[nextLayer].classList.add('active');
    heroLayers[heroVisibleLayer].classList.remove('active');
    heroCurrent = nextIndex;
    heroVisibleLayer = nextLayer;
    $('#heroIndex').textContent = String(heroCurrent + 1).padStart(2, '0');
  };
  $('#heroPrev').addEventListener('click', () => goHero(-1));
  $('#heroNext').addEventListener('click', () => goHero(1));
  if (!reduceMotion) setInterval(() => { if (!document.hidden && !document.body.classList.contains('modal-open')) goHero(1); }, 6500);

  // Portfolio category filters and keyboard-accessible full-screen viewer.
  const cards = $$('.gallery-card');
  const filterButtons = $$('.filter-btn');
  const lightbox = $('#lightbox');
  const lightboxImage = $('#lightboxImage');
  let visibleCards = cards.slice(), activeIndex = 0, previousFocus = null;
  filterButtons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.filter;
    filterButtons.forEach(item => { item.classList.toggle('active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
    visibleCards = cards.filter(card => category === 'all' || card.dataset.category === category);
    cards.forEach(card => {
      const show = visibleCards.includes(card);
      card.classList.toggle('hidden', !show);
      card.classList.toggle('filtered', category !== 'all');
      card.setAttribute('aria-hidden', String(!show));
      card.tabIndex = show ? 0 : -1;
    });
  }));
  const updateLightbox = () => {
    const card = visibleCards[activeIndex];
    if (!card) return;
    const img = $('img', card);
    lightboxImage.src = card.dataset.image || img.currentSrc || img.src;
    lightboxImage.alt = img.alt;
    $('#lightboxTitle').textContent = card.dataset.title;
    $('#lightboxSubtitle').textContent = card.dataset.subtitle;
  };
  const openLightbox = (card) => {
    previousFocus = document.activeElement;
    activeIndex = visibleCards.indexOf(card);
    if (activeIndex === -1) return;
    updateLightbox();
    lightbox.inert = false;
    lightbox.setAttribute('aria-hidden','false');
    lightbox.classList.add('open');
    document.body.classList.add('modal-open');
    $('#lightboxClose').focus();
  };
  const closeLightbox = () => {
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden','true');
    lightbox.inert = true;
    lightboxImage.removeAttribute('src');
    document.body.classList.remove('modal-open');
    previousFocus?.focus({preventScroll:true});
  };
  const shiftLightbox = step => { activeIndex = (activeIndex + step + visibleCards.length) % visibleCards.length; updateLightbox(); };
  cards.forEach(card => card.addEventListener('click', () => openLightbox(card)));
  $('#lightboxClose').addEventListener('click', closeLightbox);
  $('[data-close-lightbox]').addEventListener('click', closeLightbox);
  $('#lightboxPrev').addEventListener('click', () => shiftLightbox(-1));
  $('#lightboxNext').addEventListener('click', () => shiftLightbox(1));
  document.addEventListener('keydown', e => {
    if (!lightbox.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') shiftLightbox(-1);
    if (e.key === 'ArrowRight') shiftLightbox(1);
    if (e.key === 'Tab') {
      const focusables = $$('#lightbox button');
      const idx = focusables.indexOf(document.activeElement);
      if (e.shiftKey && idx === 0) { e.preventDefault(); focusables.at(-1).focus(); }
      else if (!e.shiftKey && idx === focusables.length - 1) { e.preventDefault(); focusables[0].focus(); }
    }
  });

  // Service selection changes the adjacent editorial photograph and contextual WhatsApp enquiry.
  const serviceButtons = $$('.service-item');
  const servicePhoto = $('#servicePhoto');
  let serviceTransition;
  serviceButtons.forEach(button => button.addEventListener('click', () => {
    if (button.classList.contains('active')) return;
    serviceButtons.forEach(item => {item.classList.toggle('active', item === button);item.setAttribute('aria-expanded', String(item === button));});
    servicePhoto.classList.add('change');
    clearTimeout(serviceTransition);
    serviceTransition = setTimeout(() => {
      servicePhoto.style.backgroundImage = `url('${button.dataset.image}')`;
      $('#serviceCounter').textContent = `${button.dataset.number} / 06`;
      servicePhoto.classList.remove('change');
    }, reduceMotion ? 0 : 240);
    const service = button.dataset.title;
    const text = `Hello Chellan's Studio, I would like to enquire about ${service}.`;
    const enquiry = $('#serviceEnquiry');
    enquiry.href = `https://wa.me/918136846979?text=${encodeURIComponent(text)}`;
    enquiry.querySelector('span').textContent = '↗';
    enquiry.firstChild.textContent = `ENQUIRE ABOUT ${service.toUpperCase()} `;
  }));

  // Demo enquiry intentionally uses WhatsApp, not a non-existent backend.
  const form = $('#enquiryForm');
  const formMessage = $('#formMessage');
  $('#preferredDate').min = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0,10);
  form.addEventListener('submit', e => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const phone = String(data.get('phone') || '').trim();
    const service = String(data.get('service') || '').trim();
    if (name.length < 2 || !/^[+\d\s()\-]{7,20}$/.test(phone) || phone.replace(/\D/g,'').length < 7 || !service) {
      formMessage.textContent = 'Please enter your name, a valid phone number, and the service you need.';
      formMessage.classList.add('error');
      form.reportValidity();
      return;
    }
    const date = String(data.get('date') || '').trim();
    const note = String(data.get('message') || '').trim();
    const message = [`Hello Chellan's Studio! I'd like to make an enquiry.`, `Name: ${name}`, `Phone: ${phone}`, `Service: ${service}`, date ? `Preferred date: ${date}` : '', note ? `Details: ${note}` : '', 'Please let me know the next steps.'].filter(Boolean).join('\n');
    const url = `https://wa.me/918136846979?text=${encodeURIComponent(message)}`;
    formMessage.classList.remove('error');
    formMessage.textContent = 'WhatsApp is opening with your enquiry. Please press Send there to submit it.';
    const popup = window.open(url, '_blank', 'noopener,noreferrer');
    if (!popup) window.location.href = url;
  });
  $('#year').textContent = new Date().getFullYear();
})();

</script>
</body>
</html>
